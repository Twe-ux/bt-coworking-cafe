# Production Environment Variables
# Copy this file and configure with your production values

# MongoDB Connection (Production)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority

# NextAuth Configuration (Production)
NEXTAUTH_URL=https://new.coworkingcafe.fr
NEXTAUTH_SECRET=GENERATE_A_NEW_SECRET_HERE

# Application
NODE_ENV=production

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe (Production - use live keys)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_LIVE_MODE=true

# Resend Email Service
# IMPORTANT: Configure these in production!
RESEND_API_KEY=re_YOUR_PRODUCTION_API_KEY
RESEND_FROM_EMAIL=noreply@coworkingcafe.fr
# Note: You MUST verify this domain in Resend dashboard first!

# Steps to configure Resend:
# 1. Go to https://resend.com/api-keys and create a new API key
# 2. Go to https://resend.com/domains and add coworkingcafe.fr
# 3. Verify the domain by adding the DNS records
# 4. Use an email from your verified domain in RESEND_FROM_EMAIL
